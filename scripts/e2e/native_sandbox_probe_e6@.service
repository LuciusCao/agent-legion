[Unit]
Description=Agent Legion disposable E6 direct-bwrap candidate (CI only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent-legion-sandbox-probe
Group=agent-legion-sandbox-probe
WorkingDirectory=/var/lib/agent-legion-native-sandbox-probe
Environment=HOME=/var/lib/agent-legion-native-sandbox-probe
Environment=USER=agent-legion-sandbox-probe
Environment=LOGNAME=agent-legion-sandbox-probe
Environment=AGENT_LEGION_SKIP_DOTENV=1
StateDirectory=agent-legion-native-sandbox-probe
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/agent-legion-native-sandbox-probe/repo/scripts/e2e/native_sandbox_probe_e6.py --state-dir /var/lib/agent-legion-native-sandbox-probe --output-dir /var/lib/agent-legion-native-sandbox-probe/evidence --phase %i --summarize
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot noroot-locked no-setuid-fixup no-setuid-fixup-locked
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-legion-native-sandbox-probe
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitNOFILE=65535
TimeoutStartSec=10min
TimeoutStopSec=35s
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-legion-native-sandbox-probe-e6
