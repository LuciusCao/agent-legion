# Agent Legion runtime secrets and overrides.
# Copy this file to `.env` and fill in values; never commit the `.env` file.

# CMS authentication (read directly by the CMS client and token generator).
# CMS_BASE_URL overrides config/agent_legion.yaml cms.base_url.
# The old BASECMS_* names remain as deprecated aliases (de-identification D3):
# set at most one of CMS_X / BASECMS_X per key; if both are set they must
# match, otherwise startup fails. Prefer CMS_*.
CMS_BASE_URL=
CMS_TOKEN=
CMS_APP_ID=
CMS_NONCE=
CMS_SECRET=
CMS_TOKEN_URL=

# Optional overrides for values in config/*.yaml.
AGENT_LEGION_DATABASE_URL=postgresql://127.0.0.1:5432/agent_legion
# Deprecated alias for AGENT_LEGION_DATABASE_URL (config governance G4). Kept for
# the transition window: set at most one of the two; if both are set they must
# match, otherwise startup fails. Prefer AGENT_LEGION_DATABASE_URL.
# VIDEO_HIVE_DATABASE_URL=
# VIDEO_HIVE_CMS_TOKEN supplies the CMS token (same effect as CMS_TOKEN).
# VIDEO_HIVE_CMS_TOKEN_GEN_SECRET supplies the token_gen secret (same as CMS_SECRET).
VIDEO_HIVE_CMS_TOKEN=
VIDEO_HIVE_CMS_TOKEN_GEN_SECRET=
VIDEO_HIVE_ASR_WHISPER_BINARY=
VIDEO_HIVE_ASR_WHISPER_MODEL=
VIDEO_HIVE_ASR_SENSEVOICE_MODEL_DIR=
VIDEO_HIVE_PI_BINARY=
VIDEO_HIVE_OPENCLAW_CWD=

# Agent Worker registration (maps to agent_workers.register_token in config/workflow.yaml).
# Set exactly one of the two; the _FILE variant is preferred in container deployments.
# AGENT_LEGION_WORKER_REGISTER_TOKEN=
# AGENT_LEGION_WORKER_REGISTER_TOKEN_FILE=/run/secrets/agent_worker_register_token

# Vault master key (maps to vault.master_key): a Fernet key used to encrypt
# workspace secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without a key the server still starts, but vault writes and secret_ref
# resolution fail until one is configured. Set at most one of the two.
# AGENT_LEGION_VAULT_MASTER_KEY=
# AGENT_LEGION_VAULT_MASTER_KEY_FILE=/run/secrets/agent_legion_vault_master_key

# Frontend dev proxy target. Also available in frontend/.env.example; used by Vite during `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8000

# Browser origins are configured under server.cors in config/app.yaml. Keep the list explicit;
# do not use a wildcard when credentialed CORS is enabled.
