# Agent Legion runtime secrets and overrides.
# Copy this file to `.env` and fill in values; never commit the `.env` file.

# CMS credentials — MIGRATION SOURCE ONLY, not a runtime channel.
# The env CMS_* channel is retired: these variables are no longer read while
# the server runs. They are consulted exactly once, by the first-startup
# migration that folds any values found here into the instance-level
# `cms-internal` external connection (admin settings → 外部服务连接;
# credentials are Fernet-encrypted in `instance_secrets`). New deployments
# should leave these empty and configure the connection in the admin UI
# instead. Migration sources (first match wins): a static token
# (CMS_TOKEN / AGENT_LEGION_CMS_TOKEN, BASECMS_TOKEN alias) → a
# `static_bearer` connection; otherwise the token_gen quartet
# (CMS_APP_ID / CMS_NONCE / CMS_SECRET / CMS_TOKEN_URL, BASECMS_* aliases) →
# an HMAC exchange connection. CMS_BASE_URL (BASECMS_BASE_URL alias) seeds the
# connection endpoint config.
CMS_BASE_URL=
CMS_TOKEN=
CMS_APP_ID=
CMS_NONCE=
CMS_SECRET=
CMS_TOKEN_URL=

# Optional overrides for env-only bootstrap keys and machine-local paths
# (the runtime split yaml files config/app.yaml / workflow.yaml /
# agent_legion.yaml are retired; startup fails with guidance when present).
AGENT_LEGION_DATABASE_URL=postgresql://127.0.0.1:5432/agent_legion
# Schema changes to the bare shared `agent_legion` database (the code default
# above) require AGENT_LEGION_ALLOW_SHARED_DB_SCHEMA=1 — prod launchers set it
# (native-prod-up.sh, deploy/compose.host.yaml). Without it init_db refuses:
# a process resolving the default DSN is usually a misdirected tool (worktree
# script without .env) that would push unreleased migrations onto prod
# (2026-08-27 incident). Derived databases (test_/e2e_/worktree names) never
# need this.
# AGENT_LEGION_ALLOW_SHARED_DB_SCHEMA=1
# AGENT_LEGION_DATA_DIR overrides the data root (default: ./data).
# AGENT_LEGION_DATA_DIR=/var/lib/agent-legion
# AGENT_LEGION_CMS_TOKEN is a legacy alias of CMS_TOKEN — migration source
# only (see the CMS block above); it is not read at runtime.
AGENT_LEGION_CMS_TOKEN=
AGENT_LEGION_OPENCLAW_CWD=

# Material object storage (materials-and-runs design §6.1): instance-level
# infrastructure, env-only like AGENT_LEGION_DATABASE_URL — never tracked yaml.
# Only AGENT_LEGION_S3_BUCKET marks the store as configured; an unconfigured
# instance keeps every other feature up and degrades the materials API to 503.
# Dev worktrees get a per-worktree bucket from scripts/init-worktree.sh; the
# endpoint/credentials below point at a shared RustFS (deploy/compose.host.yaml
# rustfs service, S3 API on :9000). For AWS S3 leave the endpoint empty and
# omit the static keys to use the boto3 default credential chain.
# AGENT_LEGION_S3_ENDPOINT=http://127.0.0.1:9000
# Local RustFS orchestration switch consumed by the prod-up entries
# (scripts/local-s3-decide.sh): auto (default) starts the compose rustfs
# service when no external S3 is configured or the endpoint points at this
# machine (127.0.0.1/localhost/::1/rustfs), and skips it when the endpoint is
# remote or only bucket/credentials are set (AWS-style default endpoint);
# always = start unconditionally, never = skip unconditionally.
# AGENT_LEGION_LOCAL_S3=auto
# Client-reachable endpoint used only to sign presigned URLs (browser direct
# upload / remote worker download). Leave empty to sign with the endpoint
# above — correct when that address is already reachable from clients
# (host-native dev); required when the endpoint is an internal address such
# as compose's http://rustfs:9000.
# AGENT_LEGION_S3_PUBLIC_ENDPOINT=
# AGENT_LEGION_S3_BUCKET=agent-legion
# AGENT_LEGION_S3_REGION=us-east-1
# AGENT_LEGION_S3_ACCESS_KEY=
# AGENT_LEGION_S3_SECRET_KEY=

# Agent Worker registration no longer uses env tokens: issue scoped
# per-workspace tokens in the Host Web UI (设置 → Worker Token) and add them
# in the Worker console. The former global AGENT_LEGION_WORKER_REGISTER_TOKEN
# env vars are rejected at startup.

# Vault master key (maps to vault.master_key): a Fernet key used to encrypt
# workspace secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without a key the server still starts, but vault writes and secret_ref
# resolution fail until one is configured. Set at most one of the two.
# AGENT_LEGION_VAULT_MASTER_KEY=
# AGENT_LEGION_VAULT_MASTER_KEY_FILE=/run/secrets/agent_legion_vault_master_key

# Skills runs/scratch dir (env-only): per-execution skill snapshots and cache
# lock files. Default is a deterministic per-user temp dir (os temp dir +
# "agent-legion-skills.runs-<uid>"). Every process sharing the skill cache
# (server, lock-refresh CLI) must resolve the same path or the FileLock
# domain splits — pin this explicitly on deployments with per-process temp
# dirs (systemd PrivateTmp), a host CLI next to a containerized server
# (container /tmp != host /tmp), or a non-writable default temp dir. The
# root must be private to the service user (created/validated at 0700).
# AGENT_LEGION_SKILLS_RUNS_DIR=/var/lib/agent-legion/skills-runs

# Frontend dev proxy target. Also available in frontend/.env.example; used by Vite during `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8000

# Browser CORS origins (env-only after the config/app.yaml retirement).
# Comma-separated explicit origin list; do not use a wildcard when
# credentialed CORS is enabled. Defaults allow only the local Vite dev origin.
# AGENT_LEGION_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AGENT_LEGION_CORS_ALLOW_CREDENTIALS=false
