# Agent Legion runtime secrets and overrides.
# Copy this file to `.env` and fill in values; never commit the `.env` file.

# CMS credentials — MIGRATION SOURCE ONLY, not a runtime channel.
# The env CMS_* channel is retired: these variables are no longer read while
# the server runs. They are consulted exactly once, by the first-startup
# migration that folds any values found here into the instance-level
# `cms-internal` external connection (admin settings → 外部服务连接;
# credentials are Fernet-encrypted in `instance_secrets`). New deployments
# should leave these empty and configure the connection in the admin UI
# instead. Migration sources (first match wins): a static token
# (CMS_TOKEN / AGENT_LEGION_CMS_TOKEN, BASECMS_TOKEN alias) → a
# `static_bearer` connection; otherwise the token_gen quartet
# (CMS_APP_ID / CMS_NONCE / CMS_SECRET / CMS_TOKEN_URL, BASECMS_* aliases) →
# an HMAC exchange connection. CMS_BASE_URL (BASECMS_BASE_URL alias) seeds the
# connection endpoint config.
CMS_BASE_URL=
CMS_TOKEN=
CMS_APP_ID=
CMS_NONCE=
CMS_SECRET=
CMS_TOKEN_URL=

# Optional overrides for env-only bootstrap keys and machine-local paths
# (the runtime split yaml files config/app.yaml / workflow.yaml /
# agent_legion.yaml are retired; startup fails with guidance when present).
AGENT_LEGION_DATABASE_URL=postgresql://127.0.0.1:5432/agent_legion
# AGENT_LEGION_DATA_DIR overrides the data root (default: ./data).
# AGENT_LEGION_DATA_DIR=/var/lib/agent-legion
# AGENT_LEGION_CMS_TOKEN is a legacy alias of CMS_TOKEN — migration source
# only (see the CMS block above); it is not read at runtime.
# AGENT_LEGION_CMS_TOKEN_GEN_SECRET is fully retired: no code reads it
# anymore; move the token_gen secret onto the connection in the admin UI.
AGENT_LEGION_CMS_TOKEN=
AGENT_LEGION_OPENCLAW_CWD=

# Agent Worker registration (maps to agent_workers.register_token).
# Set exactly one of the two; the _FILE variant is preferred in container deployments.
# Without either, the host falls back to deploy/secrets/agent_worker_register_token.
# AGENT_LEGION_WORKER_REGISTER_TOKEN=
# AGENT_LEGION_WORKER_REGISTER_TOKEN_FILE=/run/secrets/agent_worker_register_token

# Vault master key (maps to vault.master_key): a Fernet key used to encrypt
# workspace secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without a key the server still starts, but vault writes and secret_ref
# resolution fail until one is configured. Set at most one of the two.
# AGENT_LEGION_VAULT_MASTER_KEY=
# AGENT_LEGION_VAULT_MASTER_KEY_FILE=/run/secrets/agent_legion_vault_master_key

# Frontend dev proxy target. Also available in frontend/.env.example; used by Vite during `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8000

# Browser CORS origins (env-only after the config/app.yaml retirement).
# Comma-separated explicit origin list; do not use a wildcard when
# credentialed CORS is enabled. Defaults allow only the local Vite dev origin.
# AGENT_LEGION_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AGENT_LEGION_CORS_ALLOW_CREDENTIALS=false
