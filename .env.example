# Agent Legion runtime secrets and overrides.
# Copy this file to `.env` and fill in values; never commit the `.env` file.

# CMS authentication (read directly by the CMS client and token generator).
# BASECMS_BASE_URL overrides config/video_hive.yaml cms.base_url.
BASECMS_BASE_URL=
BASECMS_TOKEN=
BASECMS_APP_ID=
BASECMS_NONCE=
BASECMS_SECRET=
BASECMS_TOKEN_URL=

# Optional overrides for values in config/*.yaml.
# VIDEO_HIVE_CMS_TOKEN overrides cms.token (same as BASECMS_TOKEN).
# VIDEO_HIVE_CMS_TOKEN_GEN_SECRET overrides cms.token_gen.secret (same as BASECMS_SECRET).
VIDEO_HIVE_CMS_TOKEN=
VIDEO_HIVE_CMS_TOKEN_GEN_SECRET=
VIDEO_HIVE_ASR_WHISPER_BINARY=
VIDEO_HIVE_ASR_WHISPER_MODEL=
VIDEO_HIVE_ASR_SENSEVOICE_MODEL_DIR=
VIDEO_HIVE_PI_BINARY=
VIDEO_HIVE_OPENCLAW_CWD=

# Frontend dev proxy target. Also available in frontend/.env.example; used by Vite during `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8000

# Browser origins are configured under server.cors in config/app.yaml. Keep the list explicit;
# do not use a wildcard when credentialed CORS is enabled.
