#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
# The full gate for protected branches (develop/main/release/tags) runs in
# GitHub Actions (.github/workflows/quality-gate.yml); local pre-push always
# runs the quick gate so slow checks stay off the maintainer machine.
gate="quick"
has_update=0
zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  _="$local_ref $remote_sha"
  if [[ -z "$local_sha" || "$local_sha" == "$zero_sha" ]]; then
    continue
  fi
  has_update=1
done

if [[ "$has_update" -eq 0 ]]; then
  exit 0
fi

while IFS= read -r name; do
  if [[ -n "$name" ]]; then
    unset "$name"
  fi
done < <(git rev-parse --local-env-vars)

exec "$ROOT_DIR/scripts/run-local-gate.sh" "$gate"
