#!/usr/bin/env bash
set -euo pipefail

# SIGPIPE immunity (issue #679): git runs the pre-push hook on the push's own
# stdout/stderr — under an agent harness (or `git push | tail`) those are pipes
# whose reader can walk away mid-push (output caps, truncation, a killed
# session). With the default disposition, any write to the dead pipe then
# killed the hook with SIGPIPE (141): git treats the killed hook as a failed
# one and aborts the push AFTER the gate had already passed and recorded its
# evidence — the "push twice, second one replays the cached evidence" ritual.
# Ignore SIGPIPE for the whole hook (it survives the exec into
# run-local-gate.sh); every write below is guarded so EPIPE never touches
# set -e either. The push verdict comes from the gate's exit status alone,
# never from whether the output could be drained.
trap '' PIPE
say() {
  printf '%s\n' "$*" || true
}

ROOT_DIR="$(git rev-parse --show-toplevel)"
# The full gate for protected branches (develop/main/release/tags) runs in
# GitHub Actions (.github/workflows/quality-gate.yml); local pre-push keeps
# only the fast feedback loop on the maintainer machine.
# AGENT_LEGION_GATE_LEVEL picks the local level:
#   smoke (default) — static checks + the curated smoke test tier;
#   quick           — static checks + the unit-tier quick suite (the postgres
#                     layer moved to CI / explicit GATE_TIER=postgres);
#   full            — the whole local full gate (scripts/check.sh).
# CI runs every lane of the full quick gate regardless, so the smoke default
# never weakens the server-side boundary.
level="${AGENT_LEGION_GATE_LEVEL:-smoke}"
case "$level" in
  smoke) gate="quick"; tier="smoke" ;;
  quick) gate="quick"; tier="full" ;;
  full)  gate="full";  tier="full" ;;
  *)
    echo "Unsupported AGENT_LEGION_GATE_LEVEL: $level (expected smoke|quick|full)" >&2 || true
    exit 2
    ;;
esac
export GATE_TIER="$tier"
has_update=0
force_full=0
changed_paths=""
zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  _="$local_ref"
  if [[ -z "$local_sha" || "$local_sha" == "$zero_sha" ]]; then
    continue
  fi
  has_update=1
  if [[ "$remote_sha" == "$zero_sha" ]]; then
    # New branch/tag: no remote base to diff against.
    force_full=1
    continue
  fi
  # --no-renames: classify a rename's source path too (#941), same as CI.
  if ! paths="$(git diff --name-only --no-renames "$remote_sha...$local_sha" 2>/dev/null)"; then
    force_full=1
    continue
  fi
  changed_paths+="$paths"$'\n'
done

if [[ "$has_update" -eq 0 ]]; then
  exit 0
fi

# Pick the quick-gate lanes from the pushed paths. CI runs every lane for each
# PR/push, so this only trims the local feedback loop; anything ambiguous
# (new refs, failed diff, shared files) falls back to all lanes.
compute_lanes() {
  local saw_frontend=0
  local saw_backend=0
  local saw_rust=0
  local saw_non_docs=0
  local saw_any=0
  local path
  # The classifier is control plane (#941): when the push touches it, run
  # every lane and never source the (possibly broken) new rules. Inline,
  # independent of scripts/lane-paths.sh, and checked before sourcing it.
  while IFS= read -r path; do
    if [[ "$path" == "scripts/lane-paths.sh" ]]; then
      echo "backend frontend rust"
      return
    fi
  done <<<"$changed_paths"
  # Shared docs / velites-contract path rules (CI changes job + check-quick).
  source "$ROOT_DIR/scripts/lane-paths.sh"
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    saw_any=1
    # docs/**, root *.md, LICENSE: shared rule with CI and check-quick (#941).
    if lane_path_is_docs "$path"; then
      continue
    fi
    case "$path" in
      # Shared/global files: all lanes, no trimming.
      pyproject.toml|uv.lock|Makefile|scripts/*|.githooks/*|.github/*|config/*|frontend/package.json|frontend/package-lock.json)
        echo "backend frontend rust"
        return
        ;;
      velites/*)
        saw_rust=1
        saw_non_docs=1
        if lane_path_feeds_backend "$path"; then
          saw_backend=1
        fi
        ;;
      frontend/*)
        saw_frontend=1
        saw_non_docs=1
        ;;
      *)
        saw_backend=1
        saw_non_docs=1
        ;;
    esac
  done <<<"$changed_paths"

  if [[ "$saw_any" -eq 0 ]]; then
    echo "backend frontend rust"
  elif [[ "$saw_non_docs" -eq 0 ]]; then
    echo "static"
  else
    local lanes=""
    [[ "$saw_backend" -eq 1 ]] && lanes="backend"
    [[ "$saw_frontend" -eq 1 ]] && lanes="${lanes:+$lanes }frontend"
    [[ "$saw_rust" -eq 1 ]] && lanes="${lanes:+$lanes }rust"
    echo "$lanes"
  fi
}

if [[ "$force_full" -eq 1 ]]; then
  lanes="backend frontend rust"
else
  lanes="$(compute_lanes)"
fi

while IFS= read -r name; do
  if [[ -n "$name" ]]; then
    unset "$name"
  fi
done < <(git rev-parse --local-env-vars)

# git push's pid (the exec chain keeps it as our parent): run-local-gate.sh
# snapshots git's transport children before the gate and refuses the push
# with a diagnostic if one died meanwhile, instead of letting git itself die
# with SIGPIPE (141) on the dead pipe after the gate passed (issue #679).
export AGENT_LEGION_PRE_PUSH_GIT_PID="$PPID"
exec "$ROOT_DIR/scripts/run-local-gate.sh" "$gate" "$lanes"
